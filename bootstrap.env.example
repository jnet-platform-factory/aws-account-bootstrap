# Copy to bootstrap.env and edit. Environment variables override these.
# bootstrap.env is git-ignored.

# GitHub organisation (or user) that owns the repositories below.
GITHUB_ORG=my-org

# Regions the deploy roles may act in, space-separated. Global services (IAM,
# CloudFront, Route 53, STS, Organizations) are exempt.
ALLOWED_REGIONS="us-east-1"

# Optional: Terraform state buckets no deploy role may delete, re-policy or
# un-version.
STATE_BUCKETS=""

# --- Platform: Terraform / Terragrunt ------------------------------------------
# Repositories whose workflows may assume the platform role. With reusable
# workflows, list the *calling* repositories: the OIDC subject names the caller.
PLATFORM_REPOS="infrastructure"
# GitHub environments for this role. Leave empty to use the script's arguments.
PLATFORM_ENVIRONMENTS=""
PLATFORM_ROLE_NAME=platform-deploy-role
PLATFORM_POLICY_NAME=platform-deploy-policy

# --- Apps: SAM / CloudFormation ------------------------------------------------
# Repositories whose workflows may deploy application stacks. Leave empty to
# create no app roles.
APP_REPOS="api-service worker-service"
APP_ENVIRONMENTS=""
APP_ROLE_NAME=app-deploy-role
APP_POLICY_NAME=app-deploy-policy
APP_EXEC_ROLE_NAME=app-cfn-exec-role
APP_EXEC_POLICY_NAME=app-cfn-exec-policy

# --- Test Lambda role (set to "" to skip) --------------------------------------
LAMBDA_ROLE_NAME=lambda-test-role

# --- Security group for VPC-attached functions (optional) ---------------------
# Each run asks whether this account gets one (SECURITY_GROUP=yes/no) and in
# which VPC (SECURITY_GROUP_VPC_ID, default: the default VPC of the first allowed
# region). Both are per account, so they are never saved here - set them in the
# environment to skip the questions. The group allows all egress and no ingress.
SECURITY_GROUP_NAME=app-default-sg
# Published as <prefix>/security_group_id (the group) and <prefix>/subnet_ids (every
# subnet in the VPC); set to "" to publish nothing. A parameter this did not write
# is never overwritten.
VPC_SSM_PREFIX=/default/vpc

# --- GitHub environments -------------------------------------------------------
# With the gh CLI signed in as a repository admin, create each repository's
# environments if missing and set AWS_ACCOUNT_ID, AWS_REGION and the role ARNs
# (AWS_PLATFORM_ROLE_ARN, AWS_APP_ROLE_ARN, AWS_CFN_EXEC_ROLE_ARN) in them.
# Protection rules are never touched. Set to false to manage them by hand.
CONFIGURE_GITHUB=true

# Choose every name before the first run. The guardrails are rendered with them,
# so a rename leaves the old resources unprotected and unmanaged.
