{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyLongLivedCredentials",
      "Effect": "Deny",
      "Action": [
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyTouchingTheAccessRoles",
      "Effect": "Deny",
      "Action": [
        "iam:Create*",
        "iam:Update*",
        "iam:Delete*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Detach*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*",
        "arn:aws:iam::*:role/OrganizationAccountAccessRole",
        "arn:aws:iam::*:role/stacksets-exec-*"
      ]
    },
    {
      "Sid": "DenyIdentityCenterChanges",
      "Effect": "Deny",
      "Action": [
        "sso:Create*",
        "sso:Delete*",
        "sso:Put*",
        "sso:Update*",
        "sso:Attach*",
        "sso:Detach*",
        "sso:Associate*",
        "sso:Disassociate*",
        "sso:Provision*",
        "sso:Import*",
        "sso-directory:*",
        "identitystore:Create*",
        "identitystore:Delete*",
        "identitystore:Update*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDisablingSecurityTooling",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "guardduty:Disassociate*",
        "securityhub:DisableSecurityHub",
        "securityhub:Disassociate*",
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "access-analyzer:DeleteAnalyzer",
        "ec2:DeleteFlowLogs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDestroyingBackups",
      "Effect": "Deny",
      "Action": [
        "backup:DeleteBackupVault",
        "backup:DeleteBackupVaultLockConfiguration",
        "backup:DeleteRecoveryPoint",
        "backup:UpdateRecoveryPointLifecycle",
        "rds:DeleteDBSnapshot",
        "rds:DeleteDBClusterSnapshot",
        "rds:DeleteDBInstanceAutomatedBackup",
        "rds:DeleteDBClusterAutomatedBackup",
        "dynamodb:DeleteBackup",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyBillingAndPaymentChanges",
      "Effect": "Deny",
      "Action": [
        "aws-portal:Modify*",
        "billing:Put*",
        "billing:Redeem*",
        "billing:Update*",
        "cur:Put*",
        "invoicing:Put*",
        "payments:Create*",
        "payments:Delete*",
        "payments:Make*",
        "payments:Update*",
        "tax:BatchPut*",
        "tax:Delete*",
        "tax:Put*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyLongTermCommitments",
      "Effect": "Deny",
      "Action": [
        "savingsplans:CreateSavingsPlan",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "ec2:AcceptReservedInstancesExchangeQuote",
        "rds:PurchaseReservedDBInstancesOffering",
        "elasticache:PurchaseReservedCacheNodesOffering",
        "redshift:PurchaseReservedNodeOffering",
        "es:PurchaseReservedInstanceOffering",
        "dynamodb:PurchaseReservedCapacityOfferings",
        "shield:CreateSubscription",
        "aws-marketplace:Subscribe",
        "route53domains:RegisterDomain",
        "route53domains:TransferDomain",
        "route53domains:TransferDomainToAnotherAwsAccount"
      ],
      "Resource": "*"
    }
  ]
}
