{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIam",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport",
        "iam:GenerateServiceLastAccessedDetails",
        "iam:SimulateCustomPolicy",
        "iam:SimulatePrincipalPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassRolesToServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "amplify.amazonaws.com",
            "apigateway.amazonaws.com",
            "appconfig.amazonaws.com",
            "appsync.amazonaws.com",
            "backup.amazonaws.com",
            "bedrock.amazonaws.com",
            "build.apprunner.amazonaws.com",
            "cloudformation.amazonaws.com",
            "codebuild.amazonaws.com",
            "cognito-idp.amazonaws.com",
            "ec2.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "ecs.amazonaws.com",
            "emr-serverless.amazonaws.com",
            "events.amazonaws.com",
            "firehose.amazonaws.com",
            "glue.amazonaws.com",
            "lambda.amazonaws.com",
            "logs.amazonaws.com",
            "monitoring.rds.amazonaws.com",
            "pipes.amazonaws.com",
            "rds.amazonaws.com",
            "sagemaker.amazonaws.com",
            "scheduler.amazonaws.com",
            "sns.amazonaws.com",
            "states.amazonaws.com",
            "tasks.apprunner.amazonaws.com",
            "textract.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DenyPrivilegedRoles",
      "Effect": "Deny",
      "Action": ["iam:PassRole", "sts:AssumeRole"],
      "Resource": [
        "arn:aws:iam::*:role/OrganizationAccountAccessRole",
        "arn:aws:iam::*:role/aws-reserved/*",
        "arn:aws:iam::*:role/stacksets-exec-*",
        "arn:aws:iam::*:role/platform-deploy-role",
        "arn:aws:iam::*:role/app-deploy-role",
        "arn:aws:iam::*:role/*terraform*",
        "arn:aws:iam::*:role/*Terraform*",
        "arn:aws:iam::*:role/cicd-*",
        "arn:aws:iam::*:role/platform-cicd-role"
      ]
    },
    {
      "Sid": "DenyIdentityCenterChanges",
      "Effect": "Deny",
      "Action": [
        "sso:Create*",
        "sso:Delete*",
        "sso:Put*",
        "sso:Update*",
        "sso:Attach*",
        "sso:Detach*",
        "sso:Associate*",
        "sso:Disassociate*",
        "sso:Provision*",
        "sso:Import*",
        "sso-directory:*",
        "identitystore:Create*",
        "identitystore:Delete*",
        "identitystore:Update*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDisablingSecurityTooling",
      "Effect": "Deny",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "guardduty:Disassociate*",
        "securityhub:DisableSecurityHub",
        "securityhub:Disassociate*",
        "config:StopConfigurationRecorder",
        "config:DeleteConfigurationRecorder",
        "config:DeleteDeliveryChannel",
        "access-analyzer:DeleteAnalyzer"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyLongTermCommitments",
      "Effect": "Deny",
      "Action": [
        "savingsplans:CreateSavingsPlan",
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseHostReservation",
        "ec2:AcceptReservedInstancesExchangeQuote",
        "rds:PurchaseReservedDBInstancesOffering",
        "elasticache:PurchaseReservedCacheNodesOffering",
        "redshift:PurchaseReservedNodeOffering",
        "es:PurchaseReservedInstanceOffering",
        "dynamodb:PurchaseReservedCapacityOfferings",
        "shield:CreateSubscription",
        "aws-marketplace:Subscribe",
        "route53domains:RegisterDomain",
        "route53domains:TransferDomain",
        "route53domains:TransferDomainToAnotherAwsAccount"
      ],
      "Resource": "*"
    }
  ]
}
